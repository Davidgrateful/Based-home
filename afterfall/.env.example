# ERC-20 address of the game token you launched on https://testnet.vibevibe.fun/create
# (Robinhood Chain Testnet, chain id 46630). Leave empty to show the "launch" flow.
VITE_TOKEN_ADDRESS=

# Co-op server (only needed if the game is hosted somewhere else, e.g. Vercel).
# Leave empty when the game is served by `npm start` (same origin /ws).
VITE_MP_SERVER=
